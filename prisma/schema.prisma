// Prisma schema for werewolf-ts.
//
// This models the same domain as the original Database/*.cs (EF6) project,
// with a few deliberate modernizations:
//  - GroupConfig's 64-bit flag bitmask -> real boolean columns (type-safe,
//    queryable, self-documenting).
//  - Disabled roles bitmask -> an explicit GroupDisabledRole join table.
//  - Achievements bitmask -> Achievement + PlayerAchievement join tables.
//  - Hardcoded Devs/LangAdmins arrays + Admin table -> a single AdminUser
//    table with a role enum, so admin grants can be managed without a
//    redeploy.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameMode {
  NORMAL
  CHAOS
}

/// A group's configured default mode: PLAYER_CHOICE (the default) lets /startgame vs /startchaos
/// decide per game, same as leaving /config's mode untouched; NORMAL/CHAOS force that mode
/// regardless of which command was used - mirrors the original's DbGroup.Mode == "Player" check.
enum GroupModePreference {
  PLAYER_CHOICE
  NORMAL
  CHAOS
}

enum GamePhase {
  DAY
  LYNCH
  NIGHT
}

/// Mirrors `DbGroup.ShowRolesEnd` ("None"/"Living"/"All"): how much of the end-of-game recap
/// (`GameLoop.finish`) reveals. NONE lists just player names, LIVING lists surviving players with
/// their roles, ALL lists every player (dead or alive) with their role and outcome.
enum ShowRolesEndMode {
  NONE
  LIVING
  ALL
}

enum Team {
  VILLAGE
  CULT
  WOLF
  TANNER
  NEUTRAL
  SERIAL_KILLER
  LOVERS
  ARSONIST
  SK_HUNTER
  NO_ONE
  THIEF
}

enum KillMethod {
  NONE
  LYNCH
  EAT
  SHOOT
  VISIT_WOLF
  VISIT_VICTIM
  GUARD_WOLF
  DETECTED
  FLEE
  HUNT
  HUNTER_SHOT
  LOVER_DIED
  SERIAL_KILLED
  HUNTER_CULT
  GUARD_KILLER
  VISIT_KILLER
  IDLE
  SUICIDE
  STEAL_KILLER
  CHEMISTRY
  FALL_GRAVE
  SPOTTED
  BURN
  VISIT_BURNING
  VIPER_POISON
}

/// Mirrors `RoleName` in src/domain/roles/role.ts - keep both lists in sync.
enum RoleName {
  Villager
  Drunk
  Harlot
  Seer
  Traitor
  GuardianAngel
  Detective
  Wolf
  Cursed
  Gunner
  Tanner
  Fool
  WildChild
  Beholder
  ApprenticeSeer
  Cultist
  CultistHunter
  Mason
  Doppelganger
  Cupid
  Hunter
  SerialKiller
  Sorcerer
  AlphaWolf
  WolfCub
  Blacksmith
  ClumsyGuy
  Mayor
  Prince
  Lycan
  Pacifist
  WiseElder
  Oracle
  Sandman
  WolfMan
  Thief
  Troublemaker
  Chemist
  SnowWolf
  GraveDigger
  Augur
  Arsonist
  Spumpkin
  Watchman
  Judge
  Archivist
  Tracker
  Priestess
  Mimic
  CrownPrince
  Archangel
  TrapperWolf
  ChameleonWolf
  ViperWolf
  HowlerWolf
  HypnotistWolf
  BerserkerWolf
  Necromancer
  Jester
  Hitman
  Reflector
  Avenger
  Crow
}

enum AdminRole {
  DEV
  GLOBAL_ADMIN
  LANG_ADMIN
}

enum BanScope {
  SPAM
  MANUAL
}

model Player {
  id             Int      @id @default(autoincrement())
  telegramId     BigInt   @unique
  username       String?
  displayName    String?
  languageCode   String?
  hasStartedPm   Boolean  @default(false)
  isBanned       Boolean  @default(false)
  banReason      String?
  bannedBy       BigInt?
  tempBanCount   Int      @default(0)
  /// Cumulative Telegram Stars ever paid via /donate - the running total `donationLevel` is
  /// recomputed from (see `PlayerRepository.recordDonation`'s DONATION_TIERS thresholds).
  totalDonatedStars Int   @default(0)
  donationLevel  Int      @default(0)
  isFounder      Boolean  @default(false)
  /// Cumulative across every game - "saves" (blocked attacks) aren't deaths, so unlike kills
  /// they can't be counted from `game_kills`; powers the GotYourBack achievement.
  guardianAngelSaves Int @default(0)
  /// Consecutive finished games this player was the first lynch victim in; resets to 0 the
  /// moment a game ends without that being true. Powers the BlackSheep achievement.
  firstLynchStreak   Int @default(0)
  afkCount           Int      @default(0)
  suspendedUntil     DateTime?
  points             Int      @default(0)
  gamesPlayed        Int      @default(0)
  gamesWon           Int      @default(0)
  equippedTitle      String?
  /// Opted out of /tagall community-call pings, across every group - see PlayerRepository.setTagOptOut().
  tagOptOut          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  gamePlayers        GamePlayer[]
  achievements       PlayerAchievement[]
  globalBans         GlobalBan[]
  adminGrants        AdminUser[]
  gifPack            CustomGifPack?
  reportsMade        PlayerReport[] @relation("reportsMade")
  reportsReceived    PlayerReport[] @relation("reportsReceived")

  @@map("players")
}

model Group {
  id        Int      @id @default(autoincrement())
  telegramId BigInt  @unique
  title     String?
  username  String?
  language  String   @default("en")
  mode      GroupModePreference @default(PLAYER_CHOICE)

  dayTimerSeconds     Int     @default(120)
  nightTimerSeconds   Int     @default(60)
  lynchTimerSeconds   Int     @default(60)
  maxExtendSeconds    Int     @default(0)
  maxPlayers          Int     @default(35)

  allowExtend             Boolean @default(false)
  allowFlee               Boolean @default(true)
  allowNsfw                Boolean @default(false)
  allowTanner              Boolean @default(true)
  allowFool                Boolean @default(true)
  allowCult                Boolean @default(true)
  allowThief               Boolean @default(true)
  allowArsonist            Boolean @default(true)
  thiefFull                Boolean @default(false)
  burningOverkill          Boolean @default(false)
  showRolesOnDeath         Boolean @default(true)
  showRolesEnd             ShowRolesEndMode @default(ALL)
  showIds                  Boolean @default(false)
  shufflePlayerList        Boolean @default(false)
  randomMode               Boolean @default(false)
  secretLynch              Boolean @default(false)
  secretLynchShowVotes     Boolean @default(false)
  secretLynchShowVoters    Boolean @default(false)
  pmLynchVote              Boolean @default(true)
  muteDead                 Boolean @default(true)
  tagAllOnStart            Boolean @default(false)

  botInGroup   Boolean  @default(true)
  memberCount  Int?
  preferred    Boolean  @default(false)
  inviteLink   String?
  /// Mirrors the original's `Group.CreatedBy == "BAN"` sentinel (`/bangroup`, DevOnly): the bot
  /// refuses to start a new game here and leaves on sight, persistently - unlike a plain
  /// `/leavegroup`, re-inviting the bot doesn't undo this.
  banned       Boolean  @default(false)
  /// Platform admin approval: when true, games can be played in this Telegram group.
  isApproved   Boolean  @default(false)

  /// Which approved gif pack (if any) this group broadcasts with. Optional even when the owner
  /// has other approved packs elsewhere - a group only uses one it explicitly opted into.
  defaultGifPackId Int?
  defaultGifPack   CustomGifPack? @relation(fields: [defaultGifPackId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disabledRoles GroupDisabledRole[]
  games         Game[]
  dailyStats    DailyStat[]
  members       GroupMember[]

  @@map("groups")
}

model GroupMember {
  id          Int      @id @default(autoincrement())
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  telegramId  BigInt
  username    String?
  displayName String?
  updatedAt   DateTime @updatedAt

  @@unique([groupId, telegramId])
  @@index([groupId])
  @@map("group_members")
}

/// Port of `CustomGifData`: one custom gif pack per player, one Telegram `file_id` per
/// announcement type. Unlike the original there's no CDN - each field holds whatever
/// video/animation `file_id` Telegram gave the bot when the owner submitted it (via `/setgif`),
/// which Telegram can resend indefinitely without re-uploading. No pack ships with any field
/// populated by default; until a group opts into one (`/config` -> gif pack, or a player's own
/// approved pack while they're `hasUsedAbility`-style "active" - see `game-loop.ts`), broadcasts
/// are text-only, identical to before this feature existed.
model CustomGifPack {
  id         Int      @id @default(autoincrement())
  ownerId    Int      @unique
  owner      Player   @relation(fields: [ownerId], references: [id])

  submitted  Boolean  @default(false)
  approved   Boolean  @default(false)
  nsfw       Boolean  @default(false)
  approvedBy BigInt?

  villagerDie     String?
  wolfWin         String?
  wolvesWin       String?
  villagersWin    String?
  noWinner        String?
  startGame       String?
  startChaosGame  String?
  tannerWin       String?
  cultWins        String?
  serialKillerWins String?
  loversWin       String?
  skKilled        String?
  arsonistWins    String?
  burnToDeath     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupsUsingAsDefault Group[]

  @@map("custom_gif_packs")
}

model GroupDisabledRole {
  id      Int      @id @default(autoincrement())
  groupId Int
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role    RoleName

  @@unique([groupId, role])
  @@map("group_disabled_roles")
}

model Game {
  id         Int       @id @default(autoincrement())
  groupId    Int
  group      Group     @relation(fields: [groupId], references: [id])
  groupTitleSnapshot String?
  mode       GameMode  @default(NORMAL)
  winnerTeam Team?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  players GamePlayer[]
  kills   GameKill[]

  @@index([groupId])
  @@map("games")
}

model GamePlayer {
  id        Int      @id @default(autoincrement())
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  Int
  player    Player   @relation(fields: [playerId], references: [id])
  role      RoleName
  team      Team
  survived  Boolean  @default(false)
  won       Boolean  @default(false)

  killedAs  GameKill[] @relation("victim")
  killsMade GameKill[] @relation("killer")

  @@index([gameId])
  @@index([playerId])
  @@map("game_players")
}

model GameKill {
  id             Int         @id @default(autoincrement())
  gameId         Int
  game           Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  victimId       Int
  victim         GamePlayer  @relation("victim", fields: [victimId], references: [id])
  killerId       Int?
  killer         GamePlayer? @relation("killer", fields: [killerId], references: [id])
  method         KillMethod
  phase          GamePhase
  dayNumber      Int
  createdAt      DateTime    @default(now())

  @@index([gameId])
  @@map("game_kills")
}

model Achievement {
  code        String   @id
  name        String
  description String

  players PlayerAchievement[]

  @@map("achievements")
}

model PlayerAchievement {
  id              Int         @id @default(autoincrement())
  playerId        Int
  player          Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievementCode String
  achievement     Achievement @relation(fields: [achievementCode], references: [code])
  unlockedAt      DateTime    @default(now())

  @@unique([playerId, achievementCode])
  @@map("player_achievements")
}

model AdminUser {
  id         Int       @id @default(autoincrement())
  telegramId BigInt
  role       AdminRole
  player     Player?   @relation(fields: [telegramId], references: [telegramId])

  @@unique([telegramId, role])
  @@map("admin_users")
}

model GlobalBan {
  id         Int       @id @default(autoincrement())
  telegramId BigInt
  player     Player?   @relation(fields: [telegramId], references: [telegramId])
  reason     String
  scope      BanScope  @default(MANUAL)
  bannedBy   BigInt?
  bannedAt   DateTime  @default(now())
  expiresAt  DateTime?

  @@index([telegramId])
  @@map("global_bans")
}

/// Waitlist for `/nextgame`: a player asking to be PM'd once a new game starts in a group that
/// currently has none running. Cleared (and the player notified) by GameLobbyManager.startGame(),
/// or directly by `/stopwaiting`.
model NotifyGame {
  id        Int    @id @default(autoincrement())
  userId    BigInt
  groupId   BigInt

  @@unique([userId, groupId])
  @@map("notify_games")
}

/// Daily rollup written by the stats-rotation cron job (replaces the
/// original's GlobalStat/GroupStat/DailyCount tables with one flexible one).
model DailyStat {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  groupId     Int?
  group       Group?   @relation(fields: [groupId], references: [id])
  gamesPlayed Int      @default(0)
  playersSeen Int      @default(0)

  @@unique([date, groupId])
  @@map("daily_stats")
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model PlayerReport {
  id          Int          @id @default(autoincrement())
  reporterId  BigInt
  reportedId  BigInt
  groupId     BigInt?
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  reporter    Player?      @relation("reportsMade", fields: [reporterId], references: [telegramId])
  reported    Player?      @relation("reportsReceived", fields: [reportedId], references: [telegramId])

  @@index([reporterId])
  @@index([reportedId])
  @@map("player_reports")
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Tournament {
  id           Int              @id @default(autoincrement())
  name         String
  status       TournamentStatus @default(DRAFT)
  maxTeams     Int              @default(4)
  teamSize     Int              @default(4)
  totalRounds  Int              @default(5)
  currentRound Int              @default(0)
  createdById  BigInt?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  teams        TournamentTeam[]
  rounds       TournamentRound[]

  @@map("tournaments")
}

model TournamentTeam {
  id           Int                    @id @default(autoincrement())
  tournamentId Int?
  name         String
  tag          String?
  code         String                 @unique
  totalPoints  Int                    @default(0)
  wins         Int                    @default(0)
  createdAt    DateTime               @default(now())

  tournament   Tournament?            @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  members      TournamentTeamMember[]
  pointLogs    TournamentPointLog[]

  @@map("tournament_teams")
}

/// One row per point award to a tournament team (see PlayerRepository.awardTournamentPoints) -
/// an append-only log, never updated/deleted, so a team's point total over time can be
/// reconstructed as a running sum. Powers the admin dashboard's per-tournament "evolution" view.
model TournamentPointLog {
  id        Int            @id @default(autoincrement())
  teamId    Int
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  BigInt
  points    Int
  won       Boolean
  createdAt DateTime       @default(now())

  @@index([teamId, createdAt])
  @@map("tournament_point_logs")
}

model TournamentTeamMember {
  id                Int            @id @default(autoincrement())
  teamId            Int
  playerId          BigInt
  isCaptain         Boolean        @default(false)
  pointsContributed Int            @default(0)
  createdAt         DateTime       @default(now())

  team              TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@map("tournament_team_members")
}

model TournamentRound {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  roundNumber  Int
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_rounds")
}
