# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Postgres (used by both the app and prisma migrate)
DATABASE_URL=postgresql://werewolf:werewolf@db:5432/werewolf?schema=public

# Comma-separated Telegram user IDs allowed to run dev-only commands
DEV_USER_IDS=

# Support/error reporting chat id (optional, negative for groups)
ERROR_CHAT_ID=

# Logging & Tracing
LOG_LEVEL=info
NODE_ENV=production
LOKI_HOST=http://loki:3100

# Slack Alerting Webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Mailgun Email Alerting (optional)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_TO_EMAIL=admin@yourdomain.com

# Grafana Dashboard Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Admin Web Dashboard (/admin) - REQUIRED in production, the app refuses to start without both if
# NODE_ENV=production. Generate a real secret, e.g. `openssl rand -hex 32`.
ADMIN_PASSWORD=change_me_to_a_strong_password
JWT_SECRET=change_me_to_a_long_random_string

# Gemini API key powering the AI player chat feature (optional - falls back to a heuristic
# responder without it)
GEMINI_API_KEY=

# Optional: require `Authorization: Bearer <token>` on the Prometheus /metrics endpoint (port 9090)
METRICS_TOKEN=

# Optional: comma-separated origins allowed to call the admin API cross-origin. Leave unset unless
# the dashboard is served from a different origin than this app itself.
ADMIN_ALLOWED_ORIGINS=

