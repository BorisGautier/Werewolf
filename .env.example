# Telegram
BOT_TOKEN=

# Postgres (used by both the app and prisma migrate)
DATABASE_URL=postgresql://werewolf:werewolf@localhost:5432/werewolf?schema=public

# Comma-separated Telegram user IDs allowed to run dev-only commands
DEV_USER_IDS=

# Support/error reporting chat id (optional, negative for groups)
ERROR_CHAT_ID=

# Logging
LOG_LEVEL=info

# Node.js environment
NODE_ENV=development
