# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Postgres (used by both the app and prisma migrate)
DATABASE_URL=postgresql://werewolf:werewolf@db:5432/werewolf?schema=public

# Comma-separated Telegram user IDs allowed to run dev-only commands
DEV_USER_IDS=

# Support/error reporting chat id (optional, negative for groups)
ERROR_CHAT_ID=

# Logging & Tracing
LOG_LEVEL=info
NODE_ENV=production
LOKI_HOST=http://loki:3100

# Slack Alerting Webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Mailgun Email Alerting (optional)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_TO_EMAIL=admin@yourdomain.com

# Grafana Dashboard Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

