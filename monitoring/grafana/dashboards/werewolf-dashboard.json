{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "🐺 Active Games",
      "type": "stat",
      "targets": [
        {
          "expr": "werewolf_active_games",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "🎮 Games Started",
      "type": "stat",
      "targets": [
        {
          "expr": "werewolf_games_started_total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "⚡ Telegram API Latency (P95)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(werewolf_telegram_api_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "🗄️ DB Query Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(werewolf_db_queries_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "📊 Games Started by Mode",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(werewolf_game_modes_started_total[5m])) by (mode)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "⏱️ Telegram API Call Latency Histogram",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(werewolf_telegram_api_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(werewolf_telegram_api_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(werewolf_telegram_api_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "🏆 Team Victories Breakdown",
      "type": "piechart",
      "targets": [
        {
          "expr": "werewolf_team_wins_total",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "🛡️ Moderation & Spam Detections",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(werewolf_spam_guard_detections_total[5m])",
          "legendFormat": "Spam Detections",
          "refId": "A"
        },
        {
          "expr": "rate(werewolf_bans_applied_total[5m])",
          "legendFormat": "Bans Applied",
          "refId": "B"
        }
      ]
    },
    {
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "id": 9,
      "title": "🪵 Live Application Logs (Grafana Loki)",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{service=\"werewolf-bot\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["werewolf", "monitoring", "prometheus", "loki"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "🐺 Werewolf Bot Production Dashboard",
  "uid": "werewolf-prod-dashboard"
}
